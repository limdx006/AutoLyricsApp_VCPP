#include <windows.h>

#define IDI_APP 100
IDI_APP ICON "icon.ico"

// Embedded Python helper executable (PyInstaller bundle of lyrics_fetcher.py)
// — extracted to %TEMP%\AutoLyricsApp\ at runtime and invoked directly.
PY_HELPER RCDATA "py_helper.exe"

// Embedded Python translator executable (PyInstaller bundle of
// lyrics_translator.py) — extracted the same way for romanization.
PY_TRANSLATOR RCDATA "py_translator.exe"
